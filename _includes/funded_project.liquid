<li class="funded-project" id="{{ include.project.id }}">
  <span class="funding-period">{{ include.project.period | escape }}</span>
  <div class="funding-description">
    <h3>{{ include.project.title | escape }}</h3>
    <p><span class="funding-sponsor">{{ include.project.sponsor | escape }}</span>{% if include.project.program %} · {{ include.project.program | escape }}{% endif %}<span class="funding-role">{{ include.project.role | escape }}</span></p>
  </div>
</li>
