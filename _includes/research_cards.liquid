<div class="research-grid">{% for topic in site.data.research %}<a class="research-card" href="{{ '/research/' | relative_url }}#{{ topic.id }}"><img class="research-card-image" src="{{ topic.image | relative_url }}" alt="{{ topic.image_alt | escape }}" width="{{ topic.image_width }}" height="{{ topic.image_height }}" loading="lazy"><h3>{{ topic.title }}</h3><p>{{ topic.short }}</p><span class="card-arrow" aria-hidden="true">↗</span></a>{% endfor %}</div>
